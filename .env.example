# Copia este archivo como .env y pon ahí tus llaves. El .env NUNCA se sube a Git (ya está en
# .gitignore). Aquí solo van los NOMBRES, sin valores, para saber qué hace falta.
#
# Cómo se usa: la IA lee estas variables desde el código con process.env.NOMBRE. Si una llave se
# te filtra (la pegaste en un chat, la subiste sin querer), no la borres nada más: genera otra en
# el servicio y cambia el valor aquí. Git no olvida.

# Ejemplo: llave de un servicio de IA (OpenAI, Anthropic...)
# OPENAI_API_KEY=

# Ejemplo: base de datos (Supabase)
# SUPABASE_URL=
# SUPABASE_ANON_KEY=

# Ejemplo: correo transaccional (Resend)
# RESEND_API_KEY=
